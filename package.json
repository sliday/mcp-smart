{
  "name": "mcp-smart",
  "version": "2.0.0",
  "description": "MCP server providing multi-advisor AI consultations via OpenRouter API with advanced caching, rate limiting, and security features",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-smart": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "smart.md",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepack": "npm test -- --run && npm run build"
  },
  "keywords": [
    "mcp",
    "openrouter",
    "llm",
    "ai",
    "advisor",
    "deepseek",
    "gemini",
    "openai",
    "moonshot",
    "multi-advisor",
    "caching",
    "rate-limiting"
  ],
  "author": "Stas Kulesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sliday/mcp-smart.git"
  },
  "homepage": "https://github.com/sliday/mcp-smart#readme",
  "bugs": {
    "url": "https://github.com/sliday/mcp-smart/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^1.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
